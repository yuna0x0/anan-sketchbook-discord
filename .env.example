# Discord Bot Credentials
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token
APPLICATION_ID=your_application_id

# Optional: Custom paths for data and assets
# DATA_DIR=/path/to/data
# ASSETS_DIR=/path/to/assets

# Optional: Discord Analytics token (https://discordanalytics.xyz)
# DISCORD_ANALYTICS_TOKEN=your_discord_analytics_token

# Node.js environment flag honored by many libraries (Discord Analytics
# only sends stats when this is "production"; other packages also enable
# production optimizations and quieter error output).
# Set this on your production deploy; leave commented out for local dev.
# NODE_ENV=production
